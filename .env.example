# Server-only configuration. Copy to .env locally; never commit real secrets.
PORT=3000
RP_NAME=DialysisSafe
RP_ID=localhost
ORIGIN=http://localhost:3000

# Username/password login — SERVER ONLY.
# Set these in your real .env file, not in index.html or auth.html.
AUTH_USERNAME=your-username
AUTH_PASSWORD_HASH=generate-with-npm-run-hash-password

# Gemini/Google AI key — SERVER ONLY. Never put this in index.html or browser JavaScript.
GEMINI_API_KEY=replace-with-your-gemini-api-key
